      "zh": "\u300a\u7eaa\u5143\u884c\u52a8\uff1a\u5954\u8d74 Tau \u661f\u7cfb\u300b\u5c06\u4e8e\u7f8e\u4e1c\u590f\u4ee4\u65f6\u95f4 10 \u6708 15 \u65e5\u5f00\u59cb",
      "ko": "\uc2dc\ub300 \uc791\uc804: \ud0c0\uc6b0\ub85c\uac00 \ubd81\ubbf8 \uc2dc\uac01 10\uc6d4 15\uc77c\uc5d0 \uc2dc\uc791\ub429\ub2c8\ub2e4",
      "tc": "\u300a\u5927\u7d00\u5143\u884c\u52d5\uff1a\u6843\u6e90\u4e4b\u9053\u300b\u5c07\u65bc 10 \u6708 15 \u65e5\u5c55\u958b",
      "th": "\u0e1b\u0e0f\u0e34\u0e1a\u0e31\u0e15\u0e34\u0e01\u0e32\u0e23\u0e2a\u0e33\u0e04\u0e31\u0e0d\u0e41\u0e2b\u0e48\u0e07\u0e22\u0e38\u0e04: Taubound \u0e08\u0e30\u0e40\u0e23\u0e34\u0e48\u0e21\u0e43\u0e19\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48 15 \u0e15\u0e38\u0e25\u0e32\u0e04\u0e21"
